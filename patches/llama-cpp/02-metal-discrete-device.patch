+
 ggml_metal_device_t ggml_metal_device_init(int device) {
     ggml_metal_device_t dev = calloc(1, sizeof(struct ggml_metal_device));
 
     assert(dev != NULL);
 
     if (dev->mtl_device == nil) {
-        dev->mtl_device = MTLCreateSystemDefaultDevice();
+        // ollama-metal: map this ggml backend device to a distinct PHYSICAL
+        // Metal device. Stock always used MTLCreateSystemDefaultDevice(), so on
+        // multi-die cards (e.g. dual Radeon Pro W6800X Duo = 4 dies) every ggml
+        // device pointed at the same die. We select MTLCopyAllDevices()[idx]:
+        //   - GGML_METAL_DEVICE_INDEX pins a single die for this process
+        //     (used by Ollama to run one model per die); else
+        //   - the ggml device index is used directly (multi-device in-process).
+        // Out-of-range / unset falls back to the system default device. The
+        // chosen device is retained to balance [release] in *_device_free.
+        int phys = device;
+        {
+            const char * idx_env = getenv("GGML_METAL_DEVICE_INDEX");
+            if (idx_env != NULL) {
+                phys = atoi(idx_env);
+            }
+        }
+        if (phys >= 0) {
+            NSArray<id<MTLDevice>> * all_devices = MTLCopyAllDevices();
+            if ((NSUInteger) phys < all_devices.count) {
+                dev->mtl_device = [all_devices[phys] retain];
+            }
+            [all_devices release];
+        }
+        if (dev->mtl_device == nil) {
+            dev->mtl_device = MTLCreateSystemDefaultDevice();
+        }
 
