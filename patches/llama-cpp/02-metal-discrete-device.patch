+int ggml_metal_device_count(void) {
+    // ollama-metal: report the number of physical Metal devices so the backend
+    // can register one ggml device per die. On Apple Silicon / single-GPU Macs
+    // this is 1 (unchanged behaviour); on the Mac Pro with dual W6800X Duo
+    // cards it is 4. Falls back to 1 if enumeration returns nothing.
+    int n = 0;
+    @autoreleasepool {
+        NSArray<id<MTLDevice>> * all_devices = MTLCopyAllDevices();
+        n = (int) all_devices.count;
+        [all_devices release];
+    }
+    return n > 0 ? n : 1;
+}
