@@ -139,7 +139,22 @@ ggml_metal_t ggml_metal_init(ggml_metal_device_t dev) {
         res->d_queue = dispatch_queue_create("ggml-metal", DISPATCH_QUEUE_CONCURRENT);
 
         res->use_fusion      = getenv("GGML_METAL_FUSION_DISABLE") == nil;
-        res->use_concurrency = getenv("GGML_METAL_CONCURRENCY_DISABLE") == nil;
+
+        // ollama-metal: the Metal backend's concurrent command-buffer dispatch
+        // (commandBufferWithUnretainedReferences + backend-managed memory barriers)
+        // produces numerically WRONG results on discrete AMD GPUs (no unified
+        // memory) -- e.g. the Radeon Pro W6800X on the Mac Pro. Every individual op
+        // passes test-backend-ops, but the concurrent graph corrupts intermediate
+        // tensors, yielding garbage tokens. Apple Silicon (UMA) is unaffected.
+        // Default concurrency OFF on non-UMA devices; honour the explicit env
+        // overrides (DISABLE forces off, ENABLE forces on for experimentation).
+        res->use_concurrency = props_dev->has_unified_memory;
+        if (getenv("GGML_METAL_CONCURRENCY_ENABLE") != nil) {
+            res->use_concurrency = true;
+        }
+        if (getenv("GGML_METAL_CONCURRENCY_DISABLE") != nil) {
+            res->use_concurrency = false;
+        }
 
         {
             const char * val = getenv("GGML_METAL_GRAPH_DEBUG");
@@ -414,6 +429,26 @@ void ggml_metal_get_tensor_async(ggml_metal_t ctx, const struct ggml_tensor * te
 
 bool ggml_metal_cpy_tensor_async(ggml_metal_t ctx_src, ggml_metal_t ctx_dst, const struct ggml_tensor * src, struct ggml_tensor * dst) {
     @autoreleasepool {
+        // ollama-metal: the stock async blit below assumes every Metal "device"
+        // is the same UMA GPU (true on Apple Silicon). On discrete multi-die
+        // cards (e.g. dual W6800X Duo = 4 separate GPUs) the source and
+        // destination live in different VRAMs, and this async path also relies
+        // on a cross-device event signal/wait that the stock code wires up for a
+        // single UMA queue. Rather than reimplement async cross-device ordering,
+        // we return false for any cross-device copy. ggml_backend_tensor_copy
+        // then falls back to the SYNCHRONOUS ggml_metal_buffer_cpy_tensor, which
+        // does the right thing per topology:
+        //   - default: host-mediated bounce copy (Phase C); or
+        //   - GGML_METAL_PEER_ENABLE + same Metal peer group (Infinity Fabric)
+        //     -> direct peer-to-peer blit via a remote buffer view (Phase D,
+        //     opt-in; correct but no measured inference speedup, see device.m).
+        // Either way cross-die layer-split of >32 GB models stays correct.
+        id<MTLDevice> mtl_src = ggml_metal_device_get_obj(ctx_src->dev);
+        id<MTLDevice> mtl_dst = ggml_metal_device_get_obj(ctx_dst->dev);
+        if (mtl_src != mtl_dst) {
+            return false;
+        }
+
         struct ggml_metal_buffer_id bid_src = ggml_metal_get_buffer_id(src);
         struct ggml_metal_buffer_id bid_dst = ggml_metal_get_buffer_id(dst);
 
