diff --git a/ggml/src/ggml-metal/ggml-metal-device.m b/ggml/src/ggml-metal/ggml-metal-device.m
index 05d7f4305..9f1e8100b 100644
--- a/ggml/src/ggml-metal/ggml-metal-device.m
+++ b/ggml/src/ggml-metal/ggml-metal-device.m
@@ -695,6 +695,18 @@ ggml_metal_device_t ggml_metal_device_init(int device) {
             dev->props.device = device;
             dev->props.has_simdgroup_reduction  = [dev->mtl_device supportsFamily:MTLGPUFamilyApple7];
             dev->props.has_simdgroup_reduction |= [dev->mtl_device supportsFamily:MTLGPUFamilyMetal3_GGML];
+            // ollama-metal: robustness for discrete GPUs. On the Radeon Pro
+            // W6800X (RDNA2) Metal already reports MTLGPUFamilyMetal3 and a
+            // 32-wide threadExecutionWidth, so has_simdgroup_reduction is
+            // already true and simd_sum/simd_max are correct -- this |= Mac2
+            // line is a NO-OP there. It is kept only to also enable reductions
+            // on older discrete GPUs that report Mac2 but not Metal3.
+            // NOTE: the garbage output on the W6800X was NOT caused by
+            // simdgroup caps or wavefront width (every op passes
+            // test-backend-ops); the real cause was the Metal backend's
+            // concurrent command-buffer dispatch -- see ggml-metal-context.m
+            // (use_concurrency defaults off on non-UMA devices).
+            dev->props.has_simdgroup_reduction |= [dev->mtl_device supportsFamily:MTLGPUFamilyMac2];
 
             dev->props.has_simdgroup_mm = [dev->mtl_device supportsFamily:MTLGPUFamilyApple7];
             dev->props.has_unified_memory = dev->mtl_device.hasUnifiedMemory;
@@ -1710,7 +1722,17 @@ void ggml_metal_buffer_set_tensor(ggml_metal_buffer_t buf, struct ggml_tensor *
                                                               options:MTLResourceStorageModeShared
                                                           deallocator:nil];
 
-        GGML_ASSERT(buf_src);
+        // ollama-metal: newBufferWithBytesNoCopy requires a page-aligned host
+        // pointer (and length); callers may pass an unaligned `data` (e.g. a
+        // std::vector backing store). On discrete GPUs (no unified memory) that
+        // would otherwise hit GGML_ASSERT and abort. Fall back to an aligned
+        // bounce buffer (newBufferWithLength returns page-aligned shared memory)
+        // and copy the source bytes into it first.
+        if (buf_src == nil) {
+            buf_src = [buf->dev->mtl_device newBufferWithLength:size options:MTLResourceStorageModeShared];
+            GGML_ASSERT(buf_src);
+            memcpy([buf_src contents], data_ptr, size);
+        }
 
         // dst
         struct ggml_metal_buffer_id bid_dst = ggml_metal_buffer_get_id(buf, tensor);
@@ -1767,7 +1789,17 @@ void ggml_metal_buffer_get_tensor(ggml_metal_buffer_t buf, const struct ggml_ten
                                                               options:MTLResourceStorageModeShared
                                                           deallocator:nil];
 
-        GGML_ASSERT(buf_dst);
+        // ollama-metal: see ggml_metal_buffer_set_tensor -- the destination
+        // host pointer may be unaligned (e.g. a std::vector for logits / a test
+        // harness read-back), in which case newBufferWithBytesNoCopy returns nil
+        // and stock would abort on discrete (non-UMA) GPUs. Use an aligned
+        // bounce buffer and copy the result back out afterwards.
+        bool dst_bounce = false;
+        if (buf_dst == nil) {
+            buf_dst = [buf->dev->mtl_device newBufferWithLength:size options:MTLResourceStorageModeShared];
+            GGML_ASSERT(buf_dst);
+            dst_bounce = true;
+        }
 
         id<MTLCommandBuffer> cmd_buf = [buf->dev->mtl_queue commandBufferWithUnretainedReferences];
 
@@ -1785,6 +1817,10 @@ void ggml_metal_buffer_get_tensor(ggml_metal_buffer_t buf, const struct ggml_ten
 
         [cmd_buf commit];
         [cmd_buf waitUntilCompleted];
+
+        if (dst_bounce) {
+            memcpy(data, [buf_dst contents], size);
+        }
     }
 }
 
