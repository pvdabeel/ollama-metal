+// metalDiscreteAMDFlashAttentionBroken reports whether the selected devices
+// include a discrete-AMD "Metal" GPU on which the ggml-metal flash-attention
+// kernels miscompute.
+//
+// ollama-metal: on Intel Macs the discrete AMD dies (e.g. W6800X) are labelled
+// Library=="Metal" by our discovery patch, but they lack simdgroup_matrix and
+// the reduction-based ("vec") FA kernel produces garbage output on RDNA2 (see
+// docs/flash-attention-amd.md). Apple-Silicon Metal (arm64) is unaffected and
+// keeps working. This only matters on x86_64. The experimental FA path can
+// still be forced with GGML_METAL_AMD_FA=1 for kernel development.
+func metalDiscreteAMDFlashAttentionBroken(gpus []ml.DeviceInfo) bool {
+	if runtime.GOARCH == "arm64" || os.Getenv("GGML_METAL_AMD_FA") != "" {
+		return false
+	}
+	for _, gpu := range gpus {
+		if gpu.Name == "Metal" || gpu.Library == "Metal" {
+			return true
+		}
+	}
+	return false
+}
