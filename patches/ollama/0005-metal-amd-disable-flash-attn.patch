+// metalDiscreteAMDFlashAttentionBroken reports whether the selected devices
+// include a discrete-AMD "Metal" GPU on which the ggml-metal flash-attention
+// kernels miscompute.
+//
+// ollama-metal: on Intel Macs the discrete AMD dies (e.g. W6800X) are labelled
+// Library=="Metal" by our discovery patch, but they lack simdgroup_matrix and
+// the reduction-based ("vec") FA kernel produces garbage output on RDNA2 (see
+// docs/flash-attention-amd.md). Apple-Silicon Metal (arm64) is unaffected and
+// keeps working. This only matters on x86_64. The experimental FA path can
+// still be forced with GGML_METAL_AMD_FA=1 for kernel development.
+func metalDiscreteAMDFlashAttentionBroken(gpus []ml.DeviceInfo) bool {
+	if runtime.GOARCH == "arm64" || os.Getenv("GGML_METAL_AMD_FA") != "" {
+		return false
+	}
+	for _, gpu := range gpus {
+		if gpu.Name == "Metal" || gpu.Library == "Metal" {
+			return true
+		}
+	}
+	return false
+}
+
 // LlamaServerFlashAttention resolves the flash-attention mode passed to llama-server.
 func LlamaServerFlashAttention(gpus []ml.DeviceInfo) ml.FlashAttentionType {
+	// ollama-metal: never enable FA on discrete AMD Metal (garbage output),
+	// even if the user set OLLAMA_FLASH_ATTENTION=1 (a common recommendation
+	// elsewhere). FA gives no speedup on this hardware; only GGML_METAL_AMD_FA=1
+	// opts into the known-broken experimental path.
+	if metalDiscreteAMDFlashAttentionBroken(gpus) {
+		return ml.FlashAttentionDisabled
+	}
+
 	enabled := envconfig.FlashAttention(false)
 	userSet := enabled == envconfig.FlashAttention(true)
 	if userSet {
@@ -2873,6 +2903,16 @@ func (s *llamaServerRunner) VRAMByGPU(id ml.DeviceID) uint64 {
 	// --list-devices stdout, which matches the buffer log prefix.
 	for _, gpu := range s.gpus {
 		if gpu.DeviceID == id {
+			// ollama-metal: when a runner is pinned to a single device, all of
+			// its GPU footprint belongs to that device. A pinned Metal runner
+			// (GGML_METAL_DEVICE_INDEX, g_devices=1) always labels its buffers
+			// "MTL0" regardless of which physical die it bound to, so the
+			// discovery name (e.g. "MTL2") won't match s.vramByDevice and the
+			// per-name lookup returns 0 -- causing the scheduler to double-book
+			// one die. Attribute the whole GPU footprint to the sole device.
+			if len(s.gpus) == 1 {
+				return s.memGPU
+			}
 			return s.vramByDevice[gpu.Name]
 		}
 	}
